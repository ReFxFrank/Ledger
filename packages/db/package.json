{
  "name": "@ledger/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./state": "./src/state/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drift": "drizzle-kit check",
    "seed:demo": "tsx src/seed/demo.ts",
    "keys:rotate": "tsx src/cli/rotate.ts",
    "clean": "rimraf .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@ledger/core": "workspace:*",
    "@ledger/crypto": "workspace:*",
    "@ledger/env": "workspace:*",
    "@ledger/logger": "workspace:*",
    "@ledger/providers": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
