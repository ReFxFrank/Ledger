# ─────────────────────────────────────────────────────────────────────────────
# Ledger — environment
#
# Copy to `.env` and fill in. Variables marked [REQUIRED] must be set or the app
# refuses to boot (see packages/core/src/env.ts — we fail loudly at startup rather
# than at 2am when a notification worker dereferences undefined).
#
# Nothing in this file is safe to commit once filled in. Only NEXT_PUBLIC_* values
# ever reach the browser bundle; CI greps the built client for every other name here.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── App ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Canonical origin. Used for auth callbacks, deep links in emails,
# and web-push audience. No trailing slash.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Postgres ─────────────────────────────────────────────────────────────────
# [REQUIRED] Note the non-default host port (5433) so this never collides with a
# Postgres you already have running.
DATABASE_URL=postgresql://ledger:ledger_dev_password@localhost:5433/ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=ledger
POSTGRES_PORT=5433

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
# [REQUIRED] Also on a non-default port for the same reason.
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# ── Auth (better-auth) ───────────────────────────────────────────────────────
# [REQUIRED] 32+ random bytes. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Encryption (brief §9.1) ──────────────────────────────────────────────────
# [REQUIRED] Key-encryption key, base64, exactly 32 bytes decoded.
# Generate: openssl rand -base64 32
# Aggregator access tokens are sealed with a per-record DEK, which is itself sealed
# with this KEK. Rotating this value is a `pnpm keys:rotate` away — the key_id column
# lets old and new keys coexist during the rotation.
ENCRYPTION_KEY=
# Optional: if set, the KEK is fetched from AWS KMS instead of ENCRYPTION_KEY.
KMS_KEY_ARN=

# ── Bank aggregator ──────────────────────────────────────────────────────────
# `plaid` | `fixture`. `fixture` needs no credentials and drives the whole app from
# packages/banking/fixtures — use it for local dev, demos, tests, and CI.
AGGREGATOR=fixture
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Shared secret Plaid signs webhooks with; verified before any sync is enqueued.
PLAID_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in dev: emails are written to ./.mail as .html files
# instead of being sent. Nothing is ever sent to a real address without a key.
RESEND_API_KEY=
EMAIL_FROM="Ledger <ledger@example.com>"

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
# Generate a pair: pnpm --filter @ledger/notify vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Object storage (cancellation evidence) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ledger-evidence
S3_ACCESS_KEY_ID=ledger_minio
S3_SECRET_ACCESS_KEY=ledger_minio_password
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Observability ────────────────────────────────────────────────────────────
# Both empty = Sentry disabled entirely, no network calls, no noise.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Policy ───────────────────────────────────────────────────────────────────
# Raw transactions are purged after this many months (brief §9.6, decision #6).
# Detections and subscriptions survive the purge; only the raw feed rows go.
TRANSACTION_RETENTION_MONTHS=24

# ── Feature flags ────────────────────────────────────────────────────────────
# Public /guides/cancel/[merchant] pages (brief §10.2, decision #4). Off by default.
FEATURE_PUBLIC_GUIDES=false
# Email-receipt scanning (brief decision #2). Seam exists; feature ships off.
FEATURE_EMAIL_RECEIPTS=false
