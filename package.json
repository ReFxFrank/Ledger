{
  "name": "ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Subscription command center — see every recurring charge, and get out of the ones you don't want.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @ledger/web test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ledger/db db:generate",
    "db:migrate": "pnpm --filter @ledger/db db:migrate",
    "db:studio": "pnpm --filter @ledger/db db:studio",
    "db:drift": "pnpm --filter @ledger/db db:drift",
    "seed:demo": "pnpm --filter @ledger/db seed:demo",
    "keys:rotate": "pnpm --filter @ledger/crypto keys:rotate",
    "providers:audit": "pnpm --filter @ledger/providers audit",
    "providers:validate": "pnpm --filter @ledger/providers validate",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.21.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
